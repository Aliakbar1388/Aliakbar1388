__pycache__/
*.pyc
*.pyo

# داده‌های زمان‌اجرای هوش مصنوعی (روی سیستم کاربر ساخته می‌شود)
sangar/ai/data/*.json
sangar/ai/data/*.tmp

# باینری xray (روی سیستم کاربر دانلود می‌شود)
